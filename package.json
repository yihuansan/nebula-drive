{
  "name": "nebula-drive",
  "version": "0.1.8",
  "private": true,
  "description": "NebulaDrive 星云网盘 — 对标 ZFile 的自托管网盘系统（服务端 + Web + 同步引擎 + 桌面端 + 移动端）",
  "scripts": {
    "dev:server": "pnpm --filter @nebula/server dev",
    "dev:web": "pnpm --filter @nebula/web dev",
    "dev:sync": "pnpm --filter @nebula/sync dev",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @nebula/server build",
    "build:web": "pnpm --filter @nebula/web build",
    "build:sync": "pnpm --filter @nebula/sync build",
    "start": "pnpm --filter @nebula/server start",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20"
  }
}