+}
+function closeCmdk() {
+  cmdkOpen.value = false;
+  cmdkQuery.value = '';
+  cmdkActiveIndex.value = 0;
+}
+function executeCmdk() {
+  const entry = cmdkResults.value[cmdkActiveIndex.value];
